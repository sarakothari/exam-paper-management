# Flask Secret Key — generate a strong random key for production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# PostgreSQL Database URL (Vercel Postgres / Neon / Supabase)
# Leave empty to use local SQLite in development
DATABASE_URL=

# Vercel Blob storage token — auto-set by Vercel when you add a Blob store
# Required for file upload/download on Vercel
BLOB_READ_WRITE_TOKEN=

# Set to '1' automatically on Vercel — triggers Blob storage and PostgreSQL paths
# Leave empty for local SQLite + local file storage
VERCEL=
